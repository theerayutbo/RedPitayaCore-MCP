# Safe default: deterministic local simulation and no hardware traffic.
RP_MODE=mock

# Live mode requires an explicit unicast IPv4 address. Keep this unset in mock mode.
# RP_HOST=192.0.2.25
RP_PORT=1001
RP_HTTP_PORT=80
RP_TIMEOUT=3

# Hardware RX is opt-in. No dedicated MCP TX adapter is implemented.
RP_ALLOW_RX=false

# This enables lifecycle simulation in mock mode only. Live start/stop stay blocked.
RP_ALLOW_LIFECYCLE=false

# Optional live, read-only system diagnostics over the local OpenSSH client.
# Existing key authentication and a verified known_hosts entry are required.
# RP_SSH_USER=operator
RP_SSH_PORT=22

# Optional bounded local FPGA workspace. Must be an absolute existing directory.
# These settings are independent of RP_MODE: mock mode still permits explicitly
# enabled local file writes/builds. Build inputs are executable trusted code;
# isolate the build host from all board network/device access.
# RP_PROJECT_ROOT=/absolute/path/to/fpga-project
RP_ALLOW_PROJECT_WRITE=false

# Real builds require project-write permission plus this flag and a configured
# absolute Vivado executable and per-call acknowledge_trusted_code=true.
# Leave unset/false for dry-run-only behavior.
RP_ALLOW_LOCAL_BUILD=false
# RP_VIVADO_EXECUTABLE=/absolute/path/to/vivado
RP_BUILD_TIMEOUT=300

# No setting enables a dedicated live bitstream/MMIO/ILA/TX adapter.
# Hardware planning tools are always non-executing; build-code effects are unmonitored.
