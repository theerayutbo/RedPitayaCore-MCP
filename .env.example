# Safe default: deterministic local simulation and no hardware traffic.
RP_MODE=mock

# Live mode requires an explicit unicast IPv4 address. Keep this unset in mock mode.
# RP_HOST=192.0.2.25
RP_PORT=1001
RP_HTTP_PORT=80
RP_TIMEOUT=3

# Hardware RX is opt-in. TX is absent regardless of configuration.
RP_ALLOW_RX=false

# This enables lifecycle simulation in mock mode only. Live start/stop stay blocked.
RP_ALLOW_LIFECYCLE=false

# Optional live, read-only system diagnostics over the local OpenSSH client.
# Existing key authentication and a verified known_hosts entry are required.
# RP_SSH_USER=operator
RP_SSH_PORT=22
